{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "pretest": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=tests/server.bundle.js",
    "test": "npm run pretest && NODE_OPTIONS=--experimental-vm-modules jest",
    "test:frontend": "NODE_OPTIONS=--experimental-vm-modules jest tests/frontend/encryption.test.js",
    "test:backend": "npm run pretest && NODE_OPTIONS=--experimental-vm-modules jest tests/backend/api.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.7.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jszip": "^3.4.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
