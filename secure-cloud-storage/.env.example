# Flask Secret Key for session signing
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production

# Master Encryption Key (32 bytes base64 or 64 hex chars)
# Used by the Key Management Service to derive per-user and per-file encryption keys
MASTER_ENCRYPTION_KEY=c3VwZXJzZWNyZXRtYXN0ZXJrZXkxMjM0NTY3ODkwMTI=

# Storage Backend: 'local' (development/testing) or 's3' (Amazon S3)
STORAGE_BACKEND=local

# Local storage folder for encrypted files
LOCAL_STORAGE_DIR=instance/vault_encrypted_storage

# Amazon S3 Configuration (leave blank or fill when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=my-secure-encrypted-college-vault

# Maximum File Upload Size in Bytes (default: 25MB)
MAX_CONTENT_LENGTH=26214400
