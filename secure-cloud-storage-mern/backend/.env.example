# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for User Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_pbl_2026
JWT_EXPIRES_IN=7d

# MongoDB Connection String (Local Docker MongoDB or MongoDB Atlas)
# Local Docker: mongodb://mongoadmin:secretpassword123@localhost:27017/secure_vault?authSource=admin
MONGODB_URI=mongodb://localhost:27017/secure_vault

# Storage Provider: 'minio' for local development or 's3' for AWS S3
STORAGE_PROVIDER=minio

# MinIO / S3 Configuration
S3_BUCKET_NAME=secure-cloud-files
S3_REGION=us-east-1

# MinIO Local Endpoint (Leave blank when using real AWS S3)
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true

# MinIO or AWS S3 Credentials
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminpassword
