# ==============================================================================
# SECURE CLOUD VAULT - CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STORAGE BACKEND SELECTION ('local' | 's3')
# ------------------------------------------------------------------------------
STORAGE_BACKEND=s3

# ------------------------------------------------------------------------------
# 2. LOCAL DEVELOPMENT CONFIGURATION (MinIO via docker-compose)
# ------------------------------------------------------------------------------
# Point the S3 client to the local MinIO instance (running on port 9000).
# MinIO requires forcePathStyle=true because it uses path-style routing (/bucket/key).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=secure-vault-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# MinIO Web Console URL (for browser management): http://localhost:9001

# ------------------------------------------------------------------------------
# 3. PRODUCTION CLOUD CONFIGURATION (Amazon Web Services AWS S3)
# ------------------------------------------------------------------------------
# To switch to AWS S3 in production, simply change the variables below:
# 1. Leave S3_ENDPOINT empty or unset (SDK defaults to AWS S3 endpoints).
# 2. Set S3_FORCE_PATH_STYLE to false (AWS S3 virtual-hosted style).
# 3. Supply your AWS IAM access credentials and production bucket.
#
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_BUCKET_NAME=my-production-secure-vault
# S3_REGION=us-east-1
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ------------------------------------------------------------------------------
# 4. METADATA DATABASE (MongoDB)
# ------------------------------------------------------------------------------
# Matches credentials in docker-compose.yml:
MONGODB_URI=mongodb://root:vaultsecret@localhost:27017/secure_vault?authSource=admin

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME
# ------------------------------------------------------------------------------
PORT=3000
MASTER_ENCRYPTION_KEY=college_pbl_aes256gcm_master_key_secret_2026_demo_key

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
